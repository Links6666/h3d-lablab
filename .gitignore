# ========== 虚拟环境 ==========
.venv_lab/
.venv/
env/
venv/

# ========== Python 编译缓存 ==========
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ========== 日志、临时文件 ==========
*.log
*.tmp
*.temp

# ========== VSCode 局部配置 ==========
.vscode/settings.json
.vscode/.ropeproject

# ========== 切点云大文件（文物项目：点云 / 模型 / 扫描数据不入库） ==========
*.ply
*.las
*.laz
*.obj
*.stl
*.fbx
*.glb
*.gltf
*.mtl
*.npz

# ========== 构建中间产物（PyInstaller / Inno Setup，可随时重建） ==========
build_work*/
build_out*/
dist/
packaging/Output/

# ========== 发行包（含 200 MB 级 exe，超出 GitHub 单文件上限，不入库） ==========
# 发布走 release/H3D_v<版本> 本地目录 + 发行 zip 网盘分发
release/

# ========== 开发期端到端测试项目（output 下划线目录，仅保留 _build 的写稿脚本） ==========
output/_*/
!output/_build/
output/_build/dist_v*/

# ========== 运行期派生目录（<项目根>/99_runs 下全部可重算） ==========
99_runs/

# pip editable install 临时构建产物
*.egg-info/
